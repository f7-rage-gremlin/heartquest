# HeartQuest Environment Variables
# Copy this file to .env and fill in your values

# Sentry DSN (get from https://sentry.io/settings/projects/heartquest/keys/)
VITE_SENTRY_DSN=https://xxxxxxxx@o123456.ingest.sentry.io/1234567

# App version (auto-updated during builds)
VITE_APP_VERSION=1.0.0

# Supabase (if using)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
